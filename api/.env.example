APP_NAME=Kriyabot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=private

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# --- AI assistant (Claude) ---
KRIYABOT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Optional fallback: set KRIYABOT_AI_PROVIDER=openai and fill these
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Hosted scheduler / push ---
TASKFLOW_SCHEDULER_TOKEN=
TASKFLOW_VAPID_PUBLIC_KEY=
TASKFLOW_VAPID_PRIVATE_KEY=
TASKFLOW_VAPID_SUBJECT=mailto:support@your-domain.example

# --- Production checklist ---
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_URL=https://api.your-domain.example        (email verification links use this)
# FRONTEND_URL=https://app.your-domain.example   (password reset links use this)
# SESSION_SECURE_COOKIE=true
